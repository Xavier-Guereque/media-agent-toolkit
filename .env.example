# API key de OpenRouter. Obligatoria si el agente es Claude (la usa para modelos complementarios).
# Otros agentes compatibles con OpenRouter usan su propia API integrada; no es necesario pedirla.
# Una sola key cubre LLM, visión, imágenes, voz (TTS) y clonación de voz.
OPENROUTER_API_KEY=

# OPCIONAL: API key de ElevenLabs (voz y clonación de voz).
# Solo se usa si está configurada Y el usuario lo pide, o si OpenRouter no está disponible.
# Si se deja vacía, todo lo de voz funciona por OpenRouter.
ELEVENLABS_API_KEY=

# OPCIONALES: keys para descarga de música/imágenes libres de derechos.
# Si faltan, se usan las fuentes sin key (local, procedural, wikimedia).
PIXABAY_API_KEY=
PEXELS_API_KEY=
UNSPLASH_ACCESS_KEY=

# OPCIONAL: token gratuito de Freesound para efectos de sonido CC0 (scripts/fetch_audio.py --source freesound).
# Si falta, fetch_audio.py busca en Openverse, que no pide key.
FREESOUND_TOKEN=
